# ============================================================
# SECTION 1: IMPORT LIBRARIES AND PREPARE DATA
# ============================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from IPython.display import display

# Consistent graph style
sns.set_theme(style="whitegrid")

# If df is not already loaded, uncomment this line:
# df = pd.read_csv("retail_store_inventory.csv")

# Work on a copy so the original DataFrame remains unchanged
eda_df = df.copy()

# Remove extra spaces from column names
eda_df.columns = eda_df.columns.str.strip()

# Columns required for this analysis
required_cols = [
    "Date", "Store ID", "Product ID", "Category", "Region",
    "Inventory Level", "Units Sold", "Units Ordered",
    "Demand Forecast", "Price", "Discount",
    "Weather Condition", "Holiday/Promotion",
    "Competitor Pricing", "Seasonality"
]

# Stop if any required column is missing
missing_columns = [
    col for col in required_cols
    if col not in eda_df.columns
]

if missing_columns:
    raise ValueError(
        f"Missing required columns: {missing_columns}"
    )

# Keep the expected columns in a consistent order
eda_df = eda_df[required_cols].copy()

print("=" * 65)
print("DUKAANAI: INITIAL DATASET REPORT")
print("=" * 65)

print("Dataset shape:", eda_df.shape)
print("Number of rows:", len(eda_df))
print("Number of columns:", len(eda_df.columns))

print("\nColumn names:")
print(eda_df.columns.tolist())

print("\nData types:")
print(eda_df.dtypes)


# ============================================================
# SECTION 2: HANDLE MISSING VALUES AND DUPLICATES
# ============================================================

print("\n" + "=" * 65)
print("SECTION 2: MISSING VALUES AND DUPLICATES")
print("=" * 65)

# 2.1 Count missing values before cleaning
print("\nMissing values BEFORE cleaning:")
missing_before = eda_df.isna().sum()
display(missing_before.to_frame("Missing Values"))

# 2.2 Find exact duplicate rows
exact_duplicates = eda_df.duplicated().sum()
print("\nExact duplicate rows:", exact_duplicates)

# Remove exact duplicate rows, assuming they are redundant
eda_df = eda_df.drop_duplicates().copy()

print("Rows after removing exact duplicates:", len(eda_df))

# 2.3 Convert Date into datetime format
# Invalid dates become NaT (Not a Time)
eda_df["Date"] = pd.to_datetime(
    eda_df["Date"],
    errors="coerce"
)

invalid_dates = eda_df["Date"].isna().sum()
print("\nInvalid or missing dates:", invalid_dates)

# Rows without valid dates cannot be used in time-series analysis
eda_df = eda_df.dropna(subset=["Date"]).copy()

# 2.4 Convert numerical columns into numeric data types
numeric_cols = [
    "Inventory Level",
    "Units Sold",
    "Units Ordered",
    "Demand Forecast",
    "Price",
    "Discount",
    "Holiday/Promotion",
    "Competitor Pricing"
]

for col in numeric_cols:
    eda_df[col] = pd.to_numeric(
        eda_df[col],
        errors="coerce"
    )

print("\nMissing/invalid numerical values after conversion:")
display(
    eda_df[numeric_cols]
    .isna()
    .sum()
    .to_frame("Missing or Invalid Values")
)

# 2.5 Identify negative values
# Assumption: these columns should not contain negative values.
# Verify this assumption against the dataset documentation.
non_negative_cols = [
    "Inventory Level",
    "Units Sold",
    "Units Ordered",
    "Demand Forecast",
    "Price",
    "Discount",
    "Competitor Pricing"
]

print("\nNegative values BEFORE correction:")
display(
    eda_df[non_negative_cols]
    .lt(0)
    .sum()
    .to_frame("Negative Values")
)

# Mark negative values as missing rather than changing them to zero.
# IMPORTANT: verify negative Demand Forecast values before applying
# this rule if the source defines a legitimate meaning for them.
for col in non_negative_cols:
    eda_df.loc[eda_df[col] < 0, col] = np.nan

# 2.6 Holiday/Promotion is assumed to be binary: 0 or 1
invalid_promotion = (
    eda_df["Holiday/Promotion"].notna()
    & ~eda_df["Holiday/Promotion"].isin([0, 1])
)

print(
    "\nInvalid Holiday/Promotion values:",
    invalid_promotion.sum()
)

eda_df.loc[invalid_promotion, "Holiday/Promotion"] = np.nan

# 2.7 Handle missing store/product identifiers
# Do not guess an unknown store or product ID.
eda_df = eda_df.dropna(
    subset=["Store ID", "Product ID"]
).copy()

# Fill missing descriptive categories using their mode.
# For machine learning, fit imputation values on training data only.
descriptive_cols = [
    "Category",
    "Region",
    "Weather Condition",
    "Seasonality"
]

for col in descriptive_cols:
    if eda_df[col].isna().any():
        modes = eda_df[col].mode(dropna=True)

        if not modes.empty:
            eda_df[col] = eda_df[col].fillna(modes.iloc[0])

# 2.8 Fill remaining numerical missing values with the median.
# This is an EDA cleaning baseline, not the final ML pipeline.
for col in numeric_cols:
    if eda_df[col].isna().any():
        median_value = eda_df[col].median()

        if pd.notna(median_value):
            eda_df[col] = eda_df[col].fillna(median_value)

# Mark descriptive categories that remain missing as Unknown
for col in descriptive_cols:
    eda_df[col] = eda_df[col].fillna("Unknown")

# Final missing-value report
print("\nMissing values AFTER cleaning:")
display(
    eda_df.isna()
    .sum()
    .to_frame("Remaining Missing Values")
)

print("\nDataset shape after cleaning:", eda_df.shape)


# ============================================================
# SECTION 3: VALIDATE DATES AND NUMERICAL FIELDS
# ============================================================

print("\n" + "=" * 65)
print("SECTION 3: DATA VALIDATION")
print("=" * 65)

# Check date range
print("\nDate range:")
print("Start date:", eda_df["Date"].min())
print("End date:", eda_df["Date"].max())

# Summary statistics: count, mean, std, min, quartiles and max
print("\nNumerical summary:")
display(eda_df[numeric_cols].describe().T)

# Check whether negative values remain
print("\nNegative values AFTER cleaning:")
display(
    eda_df[non_negative_cols]
    .lt(0)
    .sum()
    .to_frame("Negative Values")
)

# Confirm that non-missing promotion values are binary
print(
    "\nInvalid promotion values AFTER cleaning:",
    (
        eda_df["Holiday/Promotion"].notna()
        & ~eda_df["Holiday/Promotion"].isin([0, 1])
    ).sum()
)

# Expected record grain:
# One row per Date + Store ID + Product ID.
# Repeated keys need investigation; do not delete automatically.
key_cols = ["Date", "Store ID", "Product ID"]

duplicate_keys = eda_df.duplicated(
    subset=key_cols,
    keep=False
)

print(
    "\nRows involved in repeated Date-Store-Product keys:",
    duplicate_keys.sum()
)

if duplicate_keys.any():
    print("\nExample repeated keys to investigate:")
    display(
        eda_df.loc[duplicate_keys]
        .sort_values(key_cols)
        .head(20)
    )

# Count the number of records per date
rows_per_date = eda_df.groupby("Date").size()

print("\nMinimum rows per date:", rows_per_date.min())
print("Maximum rows per date:", rows_per_date.max())

# Count unique stores and products
print("Unique stores:", eda_df["Store ID"].nunique())
print("Unique products:", eda_df["Product ID"].nunique())

unique_store_product_pairs = (
    eda_df[["Store ID", "Product ID"]]
    .drop_duplicates()
    .shape[0]
)

print(
    "Unique store-product combinations:",
    unique_store_product_pairs
)

# Expected rows per date if every store has every product
expected_combinations = (
    eda_df["Store ID"].nunique()
    * eda_df["Product ID"].nunique()
)

print(
    "Expected rows per date if the grid is complete:",
    expected_combinations
)

# Check whether any calendar dates have no records
all_dates = pd.date_range(
    start=eda_df["Date"].min(),
    end=eda_df["Date"].max(),
    freq="D"
)

missing_dates = all_dates.difference(
    pd.DatetimeIndex(eda_df["Date"].unique())
)

print("\nDates with no records:", len(missing_dates))

if len(missing_dates) > 0:
    print("Example missing dates:", missing_dates[:10].tolist())


# ============================================================
# SECTION 4: CHRONOLOGICAL TRAIN / VALIDATION / TEST SPLIT
# ============================================================

print("\n" + "=" * 65)
print("SECTION 4: CHRONOLOGICAL DATA SPLIT")
print("=" * 65)

# Sort rows by date, store and product
eda_df = eda_df.sort_values(
    ["Date", "Store ID", "Product ID"]
).reset_index(drop=True)

# Split by unique dates, not random rows.
# Approximate proportions: 70% train, 15% validation, 15% test.
unique_dates = np.sort(
    eda_df["Date"].dropna().unique()
)

n_dates = len(unique_dates)

if n_dates < 3:
    raise ValueError(
        "Not enough unique dates for a chronological split."
    )

train_end = int(n_dates * 0.70)
validation_end = int(n_dates * 0.85)

train_dates = unique_dates[:train_end]
validation_dates = unique_dates[train_end:validation_end]
test_dates = unique_dates[validation_end:]

train_df = eda_df[
    eda_df["Date"].isin(train_dates)
].copy()

validation_df = eda_df[
    eda_df["Date"].isin(validation_dates)
].copy()

test_df = eda_df[
    eda_df["Date"].isin(test_dates)
].copy()

print("Training rows:", len(train_df))
print("Validation rows:", len(validation_df))
print("Testing rows:", len(test_df))

print("\nTraining period:")
print(train_df["Date"].min(), "to", train_df["Date"].max())

print("\nValidation period:")
print(
    validation_df["Date"].min(),
    "to",
    validation_df["Date"].max()
)

print("\nTesting period:")
print(test_df["Date"].min(), "to", test_df["Date"].max())

# Verify that the date ranges do not overlap
assert train_df["Date"].max() < validation_df["Date"].min()
assert validation_df["Date"].max() < test_df["Date"].min()

print("\nChronological split verified: no date overlap.")

# NOTE:
# For final ML training, fit preprocessing only on training data.
# Forecasting features must use information available at prediction time.
# This split alone does not create lag features or train a model.


# ============================================================
# SECTION 5: DAILY AND WEEKLY SALES TRENDS
# ============================================================

print("\n" + "=" * 65)
print("SECTION 5: DAILY AND WEEKLY SALES TRENDS")
print("=" * 65)

# GRAPH 1: DAILY TOTAL SALES
#
# Purpose:
# Calculate total Units Sold for each date across all records.
#
# X-axis: Date
# Y-axis: Total Units Sold Across All Stores and Products
#
# Visualization:
# A line chart shows how daily total sales change over time.
# Spikes and drops should be investigated, not assumed to have
# a particular cause.

daily_sales = (
    eda_df.groupby("Date")["Units Sold"]
    .sum()
    .sort_index()
)

plt.figure(figsize=(15, 5))

plt.plot(
    daily_sales.index,
    daily_sales.values,
    linewidth=1.5
)

plt.title("DukaanAI: Daily Total Units Sold")
plt.xlabel("Date")
plt.ylabel("Total Units Sold Across All Stores and Products")

plt.tight_layout()
plt.show()


# GRAPH 2: WEEKLY TOTAL SALES
#
# Purpose:
# Aggregate daily totals into weeks ending on Sunday.
#
# X-axis: Week Ending Date (Sunday)
# Y-axis: Total Units Sold During the Week
#
# Weekly totals help show broader changes while reducing
# some day-to-day variation.

weekly_sales = daily_sales.resample("W-SUN").sum()

plt.figure(figsize=(15, 5))

plt.plot(
    weekly_sales.index,
    weekly_sales.values,
    marker="o",
    markersize=3
)

plt.title("DukaanAI: Weekly Total Units Sold")
plt.xlabel("Week Ending Date (Sunday)")
plt.ylabel("Total Units Sold During the Week")

plt.tight_layout()
plt.show()

# Daily sales summary
print("\nDaily sales summary:")
display(
    daily_sales.describe()
    .to_frame("Daily Units Sold")
)

# Dates with the highest total sales
print("\nHighest-sales dates:")
display(
    daily_sales.sort_values(ascending=False)
    .head(10)
    .to_frame("Total Units Sold")
)

# Dates with the lowest total sales
print("\nLowest-sales dates:")
display(
    daily_sales.sort_values(ascending=True)
    .head(10)
    .to_frame("Total Units Sold")
)


# ============================================================
# SECTION 6: SALES BY CATEGORY, PRODUCT AND STORE
# ============================================================

print("\n" + "=" * 65)
print("SECTION 6: SALES COMPARISONS")
print("=" * 65)

# GRAPH 3: SALES BY CATEGORY
#
# First calculate count, mean, median and sum for each category.
# The table separates average performance from total sales.
#
# X-axis: Product Category
# Y-axis: Average Units Sold per Record

category_sales = (
    eda_df.groupby("Category")["Units Sold"]
    .agg(["count", "mean", "median", "sum"])
    .sort_values("sum", ascending=False)
)

print("\nSales by category:")
display(category_sales)

plt.figure(figsize=(10, 5))

sns.barplot(
    data=eda_df,
    x="Category",
    y="Units Sold",
    estimator=np.mean,
    errorbar=None
)

plt.title("Average Units Sold by Product Category")
plt.xlabel("Product Category")
plt.ylabel("Average Units Sold per Record")
plt.xticks(rotation=30)

plt.tight_layout()
plt.show()


# GRAPH 4: SALES BY PRODUCT
#
# Purpose:
# Compare average and total sales for individual products.
#
# X-axis: Product ID
# Y-axis: Average Units Sold per Record

product_sales = (
    eda_df.groupby("Product ID")["Units Sold"]
    .agg(["count", "mean", "median", "sum"])
    .sort_values("sum", ascending=False)
)

print("\nSales by product:")
display(product_sales)

plt.figure(figsize=(12, 5))

sns.barplot(
    data=eda_df,
    x="Product ID",
    y="Units Sold",
    estimator=np.mean,
    errorbar=None
)

plt.title("Average Units Sold by Product")
plt.xlabel("Product ID")
plt.ylabel("Average Units Sold per Record")
plt.xticks(rotation=45)

plt.tight_layout()
plt.show()


# GRAPH 5: SALES BY STORE
#
# Purpose:
# Compare average sales across stores.
#
# X-axis: Store ID
# Y-axis: Average Units Sold per Record
#
# Store totals and record counts should also be checked before
# concluding that one store performs better than another.

store_sales = (
    eda_df.groupby("Store ID")["Units Sold"]
    .agg(["count", "mean", "median", "sum"])
    .sort_values("sum", ascending=False)
)

print("\nSales by store:")
display(store_sales)

plt.figure(figsize=(10, 5))

sns.barplot(
    data=eda_df,
    x="Store ID",
    y="Units Sold",
    estimator=np.mean,
    errorbar=None
)

plt.title("Average Units Sold by Store")
plt.xlabel("Store ID")
plt.ylabel("Average Units Sold per Record")

plt.tight_layout()
plt.show()


# GRAPH 6: STORE-CATEGORY COMPARISON
#
# Purpose:
# Compare category-level average sales across stores.
#
# X-axis: Store ID
# Y-axis: Average Units Sold per Record
# Different colors: Product Category

store_category_sales = (
    eda_df.groupby(["Store ID", "Category"])["Units Sold"]
    .mean()
    .reset_index(name="Average Units Sold")
)

plt.figure(figsize=(13, 6))

sns.barplot(
    data=store_category_sales,
    x="Store ID",
    y="Average Units Sold",
    hue="Category",
    errorbar=None
)

plt.title("Average Sales by Store and Category")
plt.xlabel("Store ID")
plt.ylabel("Average Units Sold per Record")

plt.legend(
    title="Product Category",
    bbox_to_anchor=(1.02, 1),
    loc="upper left"
)

plt.tight_layout()
plt.show()


# ============================================================
# SECTION 7: DISTRIBUTIONS, SCATTER PLOTS AND CORRELATION
# ============================================================

print("\n" + "=" * 65)
print("SECTION 7: PRICE, DISCOUNT AND INVENTORY ANALYSIS")
print("=" * 65)

# GRAPH 7: NUMERICAL DISTRIBUTIONS
#
# Each histogram shows the distribution of one numerical feature.
#
# X-axis: Feature value
# Y-axis: Number of Records (Frequency)
#
# Histograms help identify common ranges, spread and possible
# unusual values. An unusual value is not automatically an error.

distribution_cols = [
    "Price",
    "Discount",
    "Inventory Level",
    "Competitor Pricing",
    "Units Ordered",
    "Demand Forecast"
]

distribution_labels = {
    "Price": (
        "Price (Dataset Units)",
        "Number of Records (Frequency)"
    ),
    "Discount": (
        "Discount (Dataset Units)",
        "Number of Records (Frequency)"
    ),
    "Inventory Level": (
        "Inventory Level (Units)",
        "Number of Records (Frequency)"
    ),
    "Competitor Pricing": (
        "Competitor Pricing (Dataset Units)",
        "Number of Records (Frequency)"
    ),
    "Units Ordered": (
        "Units Ordered (Units)",
        "Number of Records (Frequency)"
    ),
    "Demand Forecast": (
        "Demand Forecast (Units)",
        "Number of Records (Frequency)"
    )
}

for col in distribution_cols:

    plt.figure(figsize=(9, 4))

    sns.histplot(
        data=eda_df,
        x=col,
        bins=30,
        kde=True
    )

    x_label, y_label = distribution_labels[col]

    plt.title(f"DukaanAI: Distribution of {col}")
    plt.xlabel(x_label)
    plt.ylabel(y_label)

    plt.tight_layout()
    plt.show()


# GRAPH 8: PRICE VS UNITS SOLD
#
# Purpose:
# Explore the association between product price and recorded sales.
#
# X-axis: Price (Dataset Units)
# Y-axis: Units Sold per Store-Product-Date Record
#
# Each point represents one record from the sampled dataset.
# Association does not prove that price caused a sales change.

price_sample = eda_df.sample(
    n=min(3000, len(eda_df)),
    random_state=42
)

plt.figure(figsize=(9, 5))

sns.scatterplot(
    data=price_sample,
    x="Price",
    y="Units Sold",
    alpha=0.5
)

plt.title("Relationship Between Price and Units Sold")
plt.xlabel("Price (Dataset Units)")
plt.ylabel("Units Sold per Store-Product-Date Record")

plt.tight_layout()
plt.show()


# GRAPH 9: DISCOUNT VS UNITS SOLD
#
# Purpose:
# Explore the association between discount and sales.
#
# X-axis: Discount (Dataset Units)
# Y-axis: Units Sold per Store-Product-Date Record
#
# The graph does not prove that discounts caused higher sales.

plt.figure(figsize=(9, 5))

sns.scatterplot(
    data=price_sample,
    x="Discount",
    y="Units Sold",
    alpha=0.5
)

plt.title("Relationship Between Discount and Units Sold")
plt.xlabel("Discount (Dataset Units)")
plt.ylabel("Units Sold per Store-Product-Date Record")

plt.tight_layout()
plt.show()


# GRAPH 10: INVENTORY VS UNITS SOLD
#
# Purpose:
# Explore the relationship between recorded inventory and sales.
#
# X-axis: Inventory Level (Units)
# Y-axis: Units Sold per Store-Product-Date Record
#
# Verify whether inventory was recorded before or after sales
# before using it as a predictive feature.

plt.figure(figsize=(9, 5))

sns.scatterplot(
    data=price_sample,
    x="Inventory Level",
    y="Units Sold",
    alpha=0.5
)

plt.title("Relationship Between Inventory and Units Sold")
plt.xlabel("Inventory Level (Units)")
plt.ylabel("Units Sold per Store-Product-Date Record")

plt.tight_layout()
plt.show()


# GRAPH 11: CORRELATION HEATMAP
#
# Purpose:
# Show pairwise linear correlations between numerical variables.
#
# Both axes list the numerical features.
# Each cell contains a correlation coefficient from -1 to +1.
#
# Positive values indicate positive linear association.
# Negative values indicate negative linear association.
# Values near zero indicate weak linear association.
#
# Correlation does not prove causation.

correlation_cols = [
    "Inventory Level",
    "Units Sold",
    "Units Ordered",
    "Demand Forecast",
    "Price",
    "Discount",
    "Holiday/Promotion",
    "Competitor Pricing"
]

correlation_matrix = eda_df[
    correlation_cols
].corr(numeric_only=True)

plt.figure(figsize=(11, 8))

sns.heatmap(
    correlation_matrix,
    annot=True,
    fmt=".2f",
    cmap="coolwarm",
    vmin=-1,
    vmax=1
)

plt.title("DukaanAI: Numerical Feature Correlation Heatmap")
plt.xlabel("Numerical Features")
plt.ylabel("Numerical Features")

plt.tight_layout()
plt.show()

# Detailed numerical summary for selected business variables
print("\nNumerical summary for business analysis:")

display(
    eda_df[
        [
            "Price",
            "Discount",
            "Inventory Level",
            "Units Sold",
            "Units Ordered",
            "Demand Forecast"
        ]
    ].describe().T
)


