# Export the chronological data partitions separately.
train_df.to_csv(
    "dukaanai_train.csv",
    index=False
)

validation_df.to_csv(
    "dukaanai_validation.csv",
    index=False
)

test_df.to_csv(
    "dukaanai_test.csv",
    index=False
)

print("Saved: dukaanai_cleaned_dataset.csv")
print("Saved: dukaanai_train.csv")
print("Saved: dukaanai_validation.csv")
